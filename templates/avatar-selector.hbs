<div class="avatar-selector-container">
    {{!-- 頂部工具列 --}}
    <header class="controls">
        <button type="button" data-action="addAvatar" class="add-btn">
            <i class="fas fa-plus" aria-hidden="true"></i> {{localize "YCIO.Avatar.Add"}}
        </button>
        <div class="info">
            {{localize "YCIO.Avatar.Managing"}} <strong>{{targetName}}</strong>
        </div>
    </header>

    {{!-- 頭像列表 --}}
    <div class="avatar-grid">
        {{!-- 1. 預設頭像 --}}
        <button type="button" class="avatar-card {{#if (eq currentAvatar '')}}selected{{/if}}"
             data-action="selectAvatar" data-src=""
             aria-pressed="{{#if (eq currentAvatar '')}}true{{else}}false{{/if}}">
            
            <span class="image-wrapper">
                <img src="{{defaultAvatar}}" alt="" />
            </span>
            
            <span class="details">
                {{!-- 預設頭像沒有輸入框，顯示標籤即可 --}}
                <span class="system-label">{{localize "YCIO.Avatar.Default"}}</span>
            </span>
        </button>
        
        {{!-- GM 專用：無頭像選項 --}}
        {{#if isGM}}
        <button type="button" class="avatar-card {{#if (eq currentAvatar '__NO_AVATAR__')}}selected{{/if}}"
             data-action="selectAvatar" data-src="__NO_AVATAR__"
             aria-pressed="{{#if (eq currentAvatar '__NO_AVATAR__')}}true{{else}}false{{/if}}">
            <span class="image-wrapper">
                <img src="icons/svg/cancel.svg" alt="" />
            </span>
            <span class="details">
                <span class="system-label">{{localize "YCIO.Avatar.NoAvatar"}}</span>
            </span>
        </button>
        {{/if}}

        {{!-- 2. 自定義頭像列表 --}}
        {{#each avatars}}
            <div class="avatar-card draggable-item {{#if (eq ../currentAvatar this.src)}}selected{{/if}}" 
                 draggable="true"
                 data-src="{{this.src}}">
                
                <div class="image-wrapper">
                    <button type="button" class="avatar-select-btn" data-action="selectAvatar"
                            data-src="{{this.src}}"
                            aria-label="{{localize 'YCIO.Avatar.Select'}} {{this.label}}"
                            aria-pressed="{{#if (eq ../currentAvatar this.src)}}true{{else}}false{{/if}}">
                        <img src="{{this.src}}" alt="" draggable="false" />
                    </button>
                    
                    {{!-- 刪除按鈕 --}}
                    <button type="button" class="delete-btn" data-action="deleteAvatar"
                            aria-label="{{localize 'YCIO.Avatar.Delete'}} {{this.label}}">
                        <i class="fas fa-times" aria-hidden="true"></i>
                    </button>
                </div>

                <div class="details">
                    {{!-- 註解輸入框 --}}
                    <input type="text" class="avatar-label-input" 
                           value="{{this.label}}" 
                           placeholder="{{localize 'YCIO.Avatar.LabelPlaceholder'}}"
                           aria-label="{{localize 'YCIO.Avatar.Label'}}">
                </div>
            </div>
        {{/each}}
    </div>

    {{!-- 底部確認按鈕 --}}
    <footer class="footer">
        <button type="button" data-action="confirm" class="confirm-btn">
            <i class="fas fa-check" aria-hidden="true"></i> {{localize "YCIO.Avatar.Confirm"}}
        </button>
    </footer>
</div>
